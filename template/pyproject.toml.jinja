[project]
name = "{{ package_name }}"
version = "0.1.0"
description = "{{ project_description }}"
readme = "README.md"
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" },
]
{% if project_type == "Application" -%}
requires-python = "=={{ python_version }}"
{%- endif %}
classifiers = [
    "Programming Language :: Python :: 3 :: Only",
    {% if project_type == "Application" -%}
    "Programming Language :: Python :: {{ python_version_minor }}",
    {%- endif %}
]

{%- if not frameworks %}
dependencies = []
{%- else %}
dependencies = [
    {%- if "Click" in frameworks %}
    "click==8.4.2",
    {%- endif %}
    {%- if "FastAPI" in frameworks %}
    "fastapi==0.138.1",
    {%- endif %}
    {%- if "LangChain" in frameworks %}
    "langchain==1.3.11",
    {%- endif %}
]
{%- endif %}

[dependency-groups]
dev = [
    {%- if use_codecov %}
    "coverage==7.14.3",
    {%- endif %}
    "ipdb==0.13.13",
    "ipython==9.14.1",
    {%- if use_ty %}
    "ty==0.0.54",
    {%- endif %}
    { include-group = "pytest" },
]
pytest = [
    "pytest==9.1.1",
    "pytest-randomly==4.1.0",
    "pytest-xdist==3.8.0",
]

[tool.uv]
# The earliest version that supports the current lock file revision
required-version = ">=0.8.4"
{% if project_type == "Application" -%}
package = false
{%- endif %}
